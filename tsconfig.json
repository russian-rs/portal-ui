{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true, // must be 'true' for correct vite work
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": "./",
    "paths": {
      "src/*": ["src/*"],
    },
    "types": [
      "jest",
      "vite/client",
      "vite-plugin-pwa/client",
    ],
    "typeRoots": [
      "src/app/types",
      "src/shared/typings",
      "./node_modules/@types",
      "./node_modules",
    ],
  },
  "files": [
    ".eslintrc.cjs",
    "commitlint.config.js",
    "jest.config.mjs",
    "vite.config.mts",
    "node_modules/@types/dom-speech-recognition/index.d.ts"
  ],
  "include": [
    "src",
    "tests",
    "src/vite-env.d.ts"
  ],
}
